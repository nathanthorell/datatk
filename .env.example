# Global settings used by MSSQL Connections
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=no

# MSSQL Connections (SQL authentication)
DEV_DB="Server=dev-server,1433;Database=your_database;UID=your_user;PWD=your_password"

# MSSQL Connections (Azure AD interactive browser auth — requires a desktop/browser environment)
DEV_DB_AZURE="Server=dev-server,1433;Database=your_database;Authentication=ActiveDirectoryInteractive"
# DEV_DB="Server=dev-server,1433;Database=your_database;UID=you@domain.com;Authentication=ActiveDirectoryInteractive"

QA_DB="Server=qa-server,1433;Database=your_database;UID=your_user;PWD=your_password"
TEST_DB="Server=test-server,1433;Database=your_database;UID=your_user;PWD=your_password"
STAGE_DB="Server=stage-server,1433;Database=your_database;UID=your_user;PWD=your_password"
PROD_DB="Server=prod-server,1433;Database=your_database;UID=your_user;PWD=your_password"

# PostgreSQL Connections
PG_DEV_DB="postgresql://your_user:your_password@dev-server:5432/your_database"
PG_QA_DB="postgresql://your_user:your_password@qa-server:5432/your_database"
PG_TEST_DB="postgresql://your_user:your_password@test-server:5432/your_database"
PG_STAGE_DB="postgresql://your_user:your_password@stage-server:5432/your_database"
PG_PROD_DB="postgresql://your_user:your_password@prod-server:5432/your_database"

# Databricks Connections (URI format)
DBX_DEV_DB="databricks://token:your_access_token@dev-workspace.cloud.databricks.com/your_catalog?http_path=/sql/1.0/warehouses/your_warehouse_id"
DBX_QA_DB="databricks://token:your_access_token@qa-workspace.cloud.databricks.com/your_catalog?http_path=/sql/1.0/warehouses/your_warehouse_id"
DBX_PROD_DB="databricks://token:your_access_token@prod-workspace.cloud.databricks.com/your_catalog?http_path=/sql/1.0/warehouses/your_warehouse_id"

# Databricks Connections (key-value format alternative)
# DBX_DEV_DB="server_hostname=dev-workspace.cloud.databricks.com;http_path=/sql/1.0/warehouses/your_warehouse_id;access_token=your_access_token;catalog=your_catalog;schema=your_schema"
